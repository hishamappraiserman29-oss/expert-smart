# Expert Smart — Environment Variable Template
# Copy to .env and fill in real values. Never commit .env with real secrets.
#
# All variables listed here are read at runtime. Missing required vars will
# raise ValueError at startup (JWT_SECRET, GOVT_SIGNING_KEY).

# ── Authentication ────────────────────────────────────────────────────────────

# Required. Strong random secret for signing JWT tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-use-a-strong-random-secret

# Optional. JWT token lifetime in seconds. Default: 3600 (1 hour).
JWT_TTL_SECONDS=3600

# DEV ONLY. Set to "1" to enable GET /api/dev/auth-token for local development.
# Must NOT be set in production. Endpoint is also blocked when FLASK_ENV=production.
# See core_engine/dev_auth.py for full documentation.
EXPERT_SMART_DEV_AUTH=

# ── Government document signing ───────────────────────────────────────────────

# Required. HMAC-SHA256 key for signing government valuation documents.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Test environments: set via pytest monkeypatch — never use a real key in tests.
GOVT_SIGNING_KEY=change-me-use-a-strong-random-signing-key

# ── Admin authorization ───────────────────────────────────────────────────────

# Comma-separated list of user_ids that have admin access.
# These user_ids are matched against the JWT sub claim.
# Example: ADMIN_USER_IDS=alice,operations@example.com
ADMIN_USER_IDS=

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed CORS origins. No wildcards in production.
# If unset, safe local-development origins are used automatically.
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────

# Set to "false" to disable rate limiting (test environments only).
# Default: "true" (enabled).
RATE_LIMIT_ENABLED=true

# ── Audit logging ─────────────────────────────────────────────────────────────

# Set to "false" to disable audit logging. Default: "true" (enabled).
AUDIT_ENABLED=true

# Path to the SQLite audit log database. Default: core_engine/audit_log.db
# Example: AUDIT_DB_PATH=/var/data/expert_smart/audit.db
AUDIT_DB_PATH=

# ── Qdrant vector store (Phase 18 — Knowledge Base Seeder) ───────────────────

# Qdrant connection for the knowledge-base seeder (qdrant_seeder.py).
# Option A — HTTP mode (docker compose -f deploy/docker-compose.yml up qdrant):
#   QDRANT_URL=http://localhost:6333
# Option B — Local embedded path mode (no Docker required):
#   Leave QDRANT_URL blank; the seeder writes to <project_root>/expert_smart_system/vector_db
QDRANT_URL=

# Qdrant collection seeded by qdrant_seeder.py (must match rag_advisor.py).
# Vector size fixed at 1024 (intfloat/multilingual-e5-large); do not change after seeding.
QDRANT_COLLECTION=egypt_estate

# SentenceTransformer model used by the seeder for embedding (local inference, no API key).
EMBED_MODEL=intfloat/multilingual-e5-large

# ── Google Cloud credentials ──────────────────────────────────────────────────

# Path to a Google service account JSON key file (for Sheets/Drive sync).
# NEVER commit the key file — it is blocked by .gitignore.
# Production: inject via your platform's secret manager (Cloud Run Secret,
#   AWS Secrets Manager, HashiCorp Vault, etc.) rather than writing to disk.
# Local dev: set this to the absolute path of your local key file.
# Generate / rotate keys at: console.cloud.google.com → IAM → Service Accounts
# Example: GOOGLE_APPLICATION_CREDENTIALS=/home/user/.secrets/service_account.json
GOOGLE_APPLICATION_CREDENTIALS=
