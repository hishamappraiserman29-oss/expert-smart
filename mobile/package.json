{
  "name": "expert-smart-mobile",
  "version": "1.0.0",
  "description": "Expert Smart Mobile / Field Mode",
  "private": true,
  "scripts": {
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.3.3",
    "@react-native-voice/voice": "^3.2.4",
    "axios": "^1.6.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-image-picker": "^7.1.2",
    "react-native-sqlite-storage": "^6.0.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^react-native-sqlite-storage$": "<rootDir>/__mocks__/react-native-sqlite-storage.ts",
      "^react-native-image-picker$": "<rootDir>/__mocks__/react-native-image-picker.ts",
      "^@react-native-community/geolocation$": "<rootDir>/__mocks__/@react-native-community/geolocation.ts",
      "^@react-native-community/netinfo$": "<rootDir>/__mocks__/@react-native-community/netinfo.ts",
      "^@react-native-voice/voice$": "<rootDir>/__mocks__/@react-native-voice/voice.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.ts",
      "^react-native-gesture-handler$": "<rootDir>/__mocks__/react-native-gesture-handler.ts",
      "^axios$": "<rootDir>/__mocks__/axios.ts",
      "^uuid$": "<rootDir>/__mocks__/uuid.ts"
    },
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": {
          "jsx": "react",
          "esModuleInterop": true,
          "strict": false
        }
      }]
    }
  }
}
